# Configuración general
APP_NAME=laix-rag-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de datos PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laix_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/laix_rag

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Daemon Watcher
DAEMON_INTERVAL_SECONDS=300
IDLE_INTERVAL_SECONDS=86400

# Seguridad / JWT
JWT_SECRET_KEY=super_secret_jwt_key_cambiar_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (separado por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Modelos / Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# Clasificador LLM para los índices de Registro Oficial. Permite: openai_compatible,
# openai, anthropic u ollama. Mantener desactivado hasta configurar proveedor y clave.
LLM_CLASSIFIER_ENABLED=false
LLM_CLASSIFIER_PROVIDER=openai_compatible
LLM_CLASSIFIER_MODEL=gpt-4.1-mini
LLM_CLASSIFIER_API_KEY=
LLM_CLASSIFIER_BASE_URL=https://api.openai.com/v1
LLM_CLASSIFIER_TIMEOUT_SECONDS=45
LLM_CLASSIFIER_TEMPERATURE=0
LLM_CLASSIFIER_MAX_INDEX_PAGES=3
LLM_CLASSIFIER_MAX_INPUT_CHARS=18000
LLM_CLASSIFIER_PROMPT_VERSION=registro-oficial-v1

# Pausar descargas y liberar PDFs ya verificados en R2 cuando el pool de data
# llegue al umbral. El RAG continúa esperando la descarga completa del lote.
PIPELINE_STORAGE_PATH=/app/data
PIPELINE_MIN_FREE_SPACE_PERCENT=20
PIPELINE_RESUME_FREE_SPACE_PERCENT=40

# Compresión del PDF enviado a R2. "ebook" mantiene buena legibilidad (150 dpi)
# y reduce notablemente los escaneos; el TXT se extrae del PDF original.
# Perfiles válidos: screen, ebook, printer, prepress, default.
PDF_OPTIMIZATION_PROFILE=ebook
PDF_OPTIMIZATION_TIMEOUT_SECONDS=600

# Cloudflare R2 (API S3 compatible; obligatorio antes de la fase upload)
# Crea un Account API token de R2 con Object Read & Write, limitado a este bucket.
# No uses aquí un token general de la API de Cloudflare.
# El panel de R2 muestra Access Key ID, Secret Access Key y el S3 endpoint.
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=laix-public-pdfs
R2_REGION=auto
R2_PREFIX=public
# Mantener false durante la primera prueba manual. Activar solo después de validar el lote.
PUBLIC_PIPELINE_SCHEDULER_ENABLED=false

# Alertas por Correo (SMTP; obligatorio para notificaciones reales)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=usuario_generado_por_brevo
SMTP_PASSWORD=tu_clave_smtp_de_brevo
SMTP_FROM_EMAIL=tu_correo_validado_en_brevo@dominio.com
ALERT_EMAIL_TO=correo_donde_recibiras_las_alertas@tudominio.com

# Dashboard de Streamlit
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin_super_seguro
