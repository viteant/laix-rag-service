# Configuración general
APP_NAME=laix-rag-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de datos PostgreSQL + pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laix_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/laix_rag

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Seguridad / Auth interna
SERVICE_API_TOKEN=dev_secret_token_laix_rag_2026

# Modelos / Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSIONS=768

# Alertas por Correo (SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=usuario_generado_por_brevo
SMTP_PASSWORD=tu_clave_smtp_de_brevo
SMTP_FROM_EMAIL=tu_correo_validado_en_brevo@dominio.com
ALERT_EMAIL_TO=correo_donde_recibiras_las_alertas@tudominio.com

