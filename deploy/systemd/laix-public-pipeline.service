[Unit]
Description=LAIX public-source pipeline scheduler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/laix-rag
# The API container shares the Docker network where PostgreSQL is reachable as `postgres`.
ExecStart=/usr/bin/docker compose -f /opt/laix-rag/docker-compose.prod.yml exec -T api python scripts/trigger_public_pipeline.py
Restart=always
RestartSec=60
