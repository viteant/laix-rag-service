FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tesseract-ocr \
    tesseract-ocr-spa \
    ocrmypdf \
    poppler-utils \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir . --extra-index-url https://download.pytorch.org/whl/cpu

# Public-source discovery is executed by Celery and requires Playwright's
# browser runtime inside the worker image.
RUN playwright install --with-deps chromium chromium-headless-shell

COPY app/ /app/app/
COPY scripts/ /app/scripts/

CMD ["celery", "-A", "app.core.celery_app.celery_app", "worker", "--loglevel=info"]
